{
  "name": "language-srs",
  "version": "0.1.0",
  "private": true,
  "description": "Exam-aligned spaced repetition for Mandarin, Japanese, Korean and Vietnamese, with home-screen widgets. Runs on web, iOS and Android from one codebase.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "core:build": "npm run build --workspace @language-srs/core",
    "core:test": "npm run test --workspace @language-srs/core",
    "test": "npm run test --workspace @language-srs/core",
    "typecheck": "npm run typecheck --workspace @language-srs/core && npm run typecheck --workspace @language-srs/mobile",
    "web": "npm run web --workspace @language-srs/mobile",
    "web:build": "npm run build:web --workspace @language-srs/mobile",
    "ios": "npm run ios --workspace @language-srs/mobile",
    "android": "npm run android --workspace @language-srs/mobile",
    "prebuild": "npm run prebuild --workspace @language-srs/mobile",
    "web:pages": "npm run build:pages --workspace @language-srs/mobile"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
