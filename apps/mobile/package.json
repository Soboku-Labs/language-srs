{
  "name": "@language-srs/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The language-srs app: one Expo codebase targeting iOS, Android and the web, plus the native home-screen widgets.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:web": "expo export --platform web --output-dir dist",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@language-srs/core": "*",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "~4.5.3",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.20.0",
    "react-native-svg": "~15.15.5",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "~0.11.3",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~57.0.5",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@language-srs/core"
      ]
    }
  }
}
