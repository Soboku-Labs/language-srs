{
  "name": "@mon/core",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-agnostic domain logic for Mon: exam curricula, FSRS scheduling, session queues, stats and the widget payload contract.",
  "type": "module",
  "main": "./src/index.ts",
