{
  "name": "@language-srs/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The language-srs account API: sign-up, sign-in, device sessions, per-account state sync and study-sitting history.",
  "main": "./src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@language-srs/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
